# Generated sources have a byte-for-byte reproducibility contract.
/project_root/assets/sorth.svg text eol=lf
/project_root/data/input/demo_source.json text eol=lf
/project_root/data/input/courses_config.json text eol=lf
# Preserve exact upstream notice bytes, including their original line endings.
/third_party/licenses/*.txt -text
/third_party/native-notices/** -text -whitespace
/third_party/mcp/licenses/*.txt -text

# Preserve the official Windows CPython license, including mixed upstream CRLF.
/third_party/licenses/cpython-3.12.10-embed-amd64-LICENSE.txt -text -whitespace
