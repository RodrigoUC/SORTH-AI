{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SORTH UI theme v1",
  "description": "Data-only theme. Maximum 16 KiB UTF-8. Structural schema validation alone does not establish contrast or runtime compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "mode",
    "colors"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Trimmed plain text only; no markup or Unicode control/format characters. The canonical validator enforces this additional rule.",
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Trimmed plain text only; no markup or Unicode control/format characters. The canonical validator enforces this additional rule.",
      "maxLength": 240
    },
    "mode": {
      "enum": [
        "light",
        "dark"
      ]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canvas",
        "surface",
        "surface_alt",
        "header",
        "header_hover",
        "on_header",
        "on_header_muted",
        "text",
        "muted",
        "heading",
        "border",
        "divider",
        "primary",
        "primary_hover",
        "primary_pressed",
        "on_primary",
        "primary_soft",
        "on_primary_soft",
        "accent",
        "on_accent",
        "accent_soft",
        "focus",
        "disabled",
        "disabled_text",
        "success",
        "success_soft",
        "warning",
        "warning_soft",
        "danger",
        "danger_soft"
      ],
      "properties": {
        "canvas": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface_alt": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "header": {
